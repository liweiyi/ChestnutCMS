<?xml version="1.0"?>
<project
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
	xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.chestnut</groupId>
		<artifactId>chestnut-cms</artifactId>
		<version>1.6.2</version>
	</parent>

	<artifactId>chestnut-cms-media</artifactId>
	<description>音频内容类型扩展模块</description>

	<dependencies>
		<!-- 音视频处理工具库 -->
		<dependency>
		    <groupId>ws.schild</groupId>
		    <artifactId>jave-core</artifactId>
		</dependency>

		<!-- 内容核心 -->
		<dependency>
			<groupId>com.chestnut</groupId>
			<artifactId>chestnut-cms-contentcore</artifactId>
		</dependency>
	</dependencies>

	<!-- 按部署平台显式选择，例如 -Pmedia-linux64；不按构建机操作系统自动选择。 -->
	<profiles>
		<profile>
			<id>media-linux64</id>
			<dependencies>
				<dependency>
					<groupId>ws.schild</groupId>
					<artifactId>jave-nativebin-linux64</artifactId>
					<scope>runtime</scope>
				</dependency>
			</dependencies>
		</profile>
		<profile>
			<id>media-win64</id>
			<dependencies>
				<dependency>
					<groupId>ws.schild</groupId>
					<artifactId>jave-nativebin-win64</artifactId>
					<scope>runtime</scope>
				</dependency>
			</dependencies>
		</profile>
		<profile>
			<id>media-osxm1</id>
			<dependencies>
				<dependency>
					<groupId>ws.schild</groupId>
					<artifactId>jave-nativebin-osxm1</artifactId>
					<scope>runtime</scope>
				</dependency>
			</dependencies>
		</profile>
		<profile>
			<id>media-osx64</id>
			<dependencies>
				<dependency>
					<groupId>ws.schild</groupId>
					<artifactId>jave-nativebin-osx64</artifactId>
					<scope>runtime</scope>
				</dependency>
			</dependencies>
		</profile>
		<!-- 默认兼容 Linux、Windows 和 macOS 本地开发；显式选择单平台 Profile 后自动停用。 -->
		<profile>
			<id>media-all</id>
			<activation>
				<activeByDefault>true</activeByDefault>
			</activation>
			<dependencies>
				<dependency>
					<groupId>ws.schild</groupId>
					<artifactId>jave-nativebin-linux64</artifactId>
					<scope>runtime</scope>
				</dependency>
				<dependency>
					<groupId>ws.schild</groupId>
					<artifactId>jave-nativebin-win64</artifactId>
					<scope>runtime</scope>
				</dependency>
				<dependency>
					<groupId>ws.schild</groupId>
					<artifactId>jave-nativebin-osxm1</artifactId>
					<scope>runtime</scope>
				</dependency>
				<dependency>
					<groupId>ws.schild</groupId>
					<artifactId>jave-nativebin-osx64</artifactId>
					<scope>runtime</scope>
				</dependency>
			</dependencies>
		</profile>
	</profiles>
</project>
